    </nav>

    <div class="social social--menu">
      <a href="https://github.com/harry7557558/spirulae-splat" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
        <svg class="icon icon--github" aria-hidden="true"><use href="#icon-github"></use></svg>
      </a>
      <a href="#" aria-label="Discord" title="Discord">
        <svg class="icon icon--discord" aria-hidden="true"><use href="#icon-discord"></use></svg>
