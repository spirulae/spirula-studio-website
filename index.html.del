<div class="grain" aria-hidden="true"></div>


<!-- ══ Header ════════════════════════════════════════════════════════════════
     Transparent over the hero; `is-solid` is added by site.js past 50px of
     scroll, which flips the whole bar to ink-on-paper via `currentColor`. -->
<header class="site-header" id="site-header">

  <a class="wordmark" href="#top" data-i18n="brand.wordmark">Spirula Studio</a>

  <nav class="nav-links" aria-label="Primary">
    <a href="#expertise" data-i18n="nav.features">Products<span class="nav-links__rule"></span></a>
    <a href="#work"      data-i18n="nav.showcase">Showcase<span class="nav-links__rule"></span></a>
    <a href="#support"   data-i18n="nav.donate">Donate<span class="nav-links__rule"></span></a>
    <a href="#contact"   data-i18n="nav.contact">Contact<span class="nav-links__rule"></span></a>
  </nav>

  <div class="header-actions">

    <!-- Discord / LinkedIn / X have no accounts yet — href="#" is a placeholder. -->
    <div class="social social--header">
      <a href="https://github.com/harry7557558/spirulae-splat" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
        <svg class="icon icon--github" aria-hidden="true"><use href="#icon-github"></use></svg>
      </a>
      <a href="#" aria-label="Discord" title="Discord">
        <svg class="icon icon--discord" aria-hidden="true"><use href="#icon-discord"></use></svg>
      </a>
      <a href="#" aria-label="LinkedIn" title="LinkedIn">
        <svg class="icon icon--linkedin" aria-hidden="true"><use href="#icon-linkedin"></use></svg>
      </a>
      <a href="#" aria-label="X" title="X">
        <svg class="icon icon--x" aria-hidden="true"><use href="#icon-x"></use></svg>
      </a>
    </div>

    <a class="pill-outline" href="#download" data-i18n="nav.download">Download</a>

    <!-- Language picker. site.js fills the button label and the menu from
         LANGUAGES in assets/js/i18n.js. -->
    <div class="lang">
      <button class="lang__button mono" type="button" id="lang-button"
              aria-label="Change language" aria-expanded="false" aria-controls="lang-menu">
        <span class="lang__code">EN</span><span class="lang__chevron" aria-hidden="true"></span>
      </button>
      <div class="lang__menu" id="lang-menu" role="menu" hidden></div>
    </div>

    <button class="menu-toggle" type="button" id="menu-toggle"
            aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
    </button>

  </div>
</header>


<!-- ══ Mobile menu ═══════════════════════════════════════════════════════════ -->
<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="mobile-menu__inner">

    <nav class="mobile-menu__links" aria-label="Mobile">
      <a href="#expertise" data-i18n="nav.features">Products</a>
      <a href="#work"      data-i18n="nav.showcase">Showcase</a>
