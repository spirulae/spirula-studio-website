<main>

<!-- ══ Hero ══════════════════════════════════════════════════════════════════ -->
<section class="hero" id="top">
  <video class="hero__video" src="assets/video/hero-loop.mp4"
         autoplay loop muted playsinline preload="auto" aria-hidden="true"></video>
  <div class="hero__wash"></div>

  <div class="hero__body">
    <p class="eyebrow eyebrow--light mono">
      <span class="eyebrow__rule"></span>
      <span data-i18n="hero.eyebrow">An all-in-one 3DGS app</span>
    </p>

    <!-- site.js rewrites .hero__brand from the `brand.hero` string, which
         splits the wordmark into an accented part and the rest. -->
    <h1 class="hero__title" data-reveal>
      <span class="hero__brand"><span class="hero__accent">Spirula</span> Studio</span>
    </h1>

    <p class="hero__sub" data-reveal data-i18n="hero.sub">We streamline the 3DGS scene reconstruction process and democratize end-to-end 3D spatial workflows.</p>

    <div class="hero__actions">
      <a class="btn btn--solid-light" href="#work"     data-i18n="hero.cta1">Showcase</a>
      <a class="btn btn--ghost-light" href="#download" data-i18n="hero.cta2">Download</a>
    </div>
  </div>

  <div class="hero__scroll">
    <span class="mono" data-i18n="hero.scroll">Scroll</span>
    <span class="hero__arrow"></span>
  </div>
</section>


<!-- ══ Products ══════════════════════════════════════════════════════════════ -->
<section class="section features" id="expertise">

  <div class="features__intro">
    <p class="eyebrow mono">
      <span class="eyebrow__rule"></span>
      <span data-i18n="sec.features">01 — Products</span>
    </p>

    <div class="features__headline">
      <h2 data-reveal data-i18n="feat.head">Everything the pipeline needs, in one window.</h2>
      <p data-reveal data-i18n="feat.sub">Import, solve, train, inspect, and export in one seamless workflow. No tool switching, no terminal commands, no fragmented pipelines. What once required multiple applications is now a single, unified interface.</p>
    </div>
  </div>

  <!-- Screen recording of the app. The frame's aspect ratio is corrected to the
       video's own once metadata loads; the value here is the placeholder. -->
  <div class="features__stage">
    <div class="features__frame" id="workspace-frame">
      <video src="assets/video/workspace-loop.mp4"
             autoplay loop muted playsinline preload="metadata" aria-hidden="true"></video>
    </div>
  </div>

  <div class="feature-grid">

    <article class="feature">
      <span class="feature__no mono">01</span>
      <h3 class="feature__title" data-i18n="feat.1t">AI-Powered Pipeline</h3>
      <p class="feature__body" data-i18n="feat.1d">Image/video processing, masking, and camera alignment are handled automatically. Simply drag your images or videos into the app and click start.</p>
    </article>

    <article class="feature">
      <span class="feature__no mono">02</span>
      <h3 class="feature__title" data-i18n="feat.2t">VRAM Efficient</h3>
      <p class="feature__body" data-i18n="feat.2d">Train massive scenes on limited VRAM. A 4K dataset with <strong>10 million</strong> full-SH Gaussians fits in <strong>8 GB</strong> — a laptop instead of an expensive workstation.</p>
    </article>

    <article class="feature">
      <span class="feature__no mono">03</span>
      <h3 class="feature__title" data-i18n="feat.3t">Native 360 Support</h3>
      <p class="feature__body" data-i18n="feat.3d">Wide fisheye and equirectangular captures are ingested directly. No unwrapping to pinhole views, no seams, no lost field of view.</p>
    </article>

    <article class="feature">
      <span class="feature__no mono">04</span>
      <h3 class="feature__title" data-i18n="feat.4t">AMD / Mac Training</h3>
      <p class="feature__body" data-i18n="feat.4d">Vulkan-accelerated training on AMD and on Apple Silicon, <strong>M1 through M4</strong>. Same pipeline, same features, same outputs, no CUDA required.</p>
    </article>

    <article class="feature">
      <span class="feature__no mono">05</span>
      <h3 class="feature__title" data-i18n="feat.5t">Accurate Color</h3>
      <p class="feature__body" data-i18n="feat.5d">A novel correction mechanism handles exposure, white balance, and changing environment light. Where a plain bilateral grid or PPISP tints surfaces or darkens the scene, ours stays neutral.</p>
    </article>

    <article class="feature">
      <span class="feature__no mono">06</span>
      <h3 class="feature__title" data-i18n="feat.6t">Floater Suppression</h3>
      <p class="feature__body" data-i18n="feat.6d">Our novel mechanism suppresses floaters and false transparencies. Clean, watertight surfaces from a single <strong>off / mild / high</strong> setting.</p>
    </article>

    <article class="feature">
      <span class="feature__no mono">07</span>
      <h3 class="feature__title" data-i18n="feat.7t">Unified Densification</h3>
      <p class="feature__body" data-i18n="feat.7d">MCMC, IGS+, and MRNF blended into a single densification strategy — the strengths of each, without having to pick a side per scene.</p>
    </article>

    <article class="feature">
      <span class="feature__no mono">08</span>
      <h3 class="feature__title" data-i18n="feat.8t">Free &amp; Open Source</h3>
      <p class="feature__body" data-i18n="feat.8d">No licence keys, no seats, no watermarks, no cloud upload. Read the source, build it yourself, and keep whatever you make.</p>
    </article>

  </div>
</section>


<!-- ══ Showcase ══════════════════════════════════════════════════════════════
     One .scene-slot per card; each slot is sticky, so the cards stack as the
     page scrolls. Titles and meta are overwritten from SCENES in i18n.js, keyed
     by data-scene (the index the "View scene" link passes along). -->
<section class="section showcase" id="work">

  <p class="eyebrow mono">
    <span class="eyebrow__rule"></span>
    <span data-i18n="sec.showcase">02 — Showcase</span>
  </p>

  <div class="scene-stack">

    <div class="scene-slot">
      <article class="scene">
        <img class="scene__img" src="assets/img/scene-st-pauls.png" alt="London — St Paul's Cathedral reconstructed as a Gaussian splat">
        <div class="scene__wash"></div>
        <p class="scene__meta mono">
          <span data-scene="0" data-scene-field="meta">01 / London</span>
          <span data-scene="0" data-scene-field="category">Interior · 360 capture</span>
        </p>
        <div class="scene__foot">
          <h3 class="scene__title" data-scene="0" data-scene-field="title">St Paul's Cathedral</h3>
          <a class="btn btn--solid-light" href="SceneViewer.dc.html?scene=0" data-scene-link="0" data-i18n="show.view">View scene</a>
        </div>
      </article>
    </div>

    <div class="scene-slot">
      <article class="scene">
        <img class="scene__img" src="assets/img/scene-business-park.png" alt="Toronto — Business Park reconstructed as a Gaussian splat">
        <div class="scene__wash"></div>
        <p class="scene__meta mono">
          <span data-scene="1" data-scene-field="meta">02 / Toronto</span>
          <span data-scene="1" data-scene-field="category">Exterior · drone video</span>
        </p>
        <div class="scene__foot">
          <h3 class="scene__title" data-scene="1" data-scene-field="title">Business Park</h3>
          <a class="btn btn--solid-light" href="SceneViewer.dc.html?scene=1" data-scene-link="1" data-i18n="show.view">View scene</a>
        </div>
      </article>
    </div>

    <div class="scene-slot">
      <article class="scene">
        <img class="scene__img" src="assets/img/scene-royal-york-lobby.png" alt="Toronto — Royal York Lobby reconstructed as a Gaussian splat">
        <div class="scene__wash"></div>
        <p class="scene__meta mono">
          <span data-scene="2" data-scene-field="meta">03 / Toronto</span>
          <span data-scene="2" data-scene-field="category">Interior · handheld</span>
        </p>
        <div class="scene__foot">
          <h3 class="scene__title" data-scene="2" data-scene-field="title">Royal York Lobby</h3>
          <a class="btn btn--solid-light" href="SceneViewer.dc.html?scene=2" data-scene-link="2" data-i18n="show.view">View scene</a>
        </div>
      </article>
    </div>

  </div>
</section>


<!-- ══ Download ══════════════════════════════════════════════════════════════
     The OS tabs, the button's href and the spec table are driven by SITE.os /
     SITE.spec in assets/js/site.js. What is written here is the Windows
     default, shown as-is when scripting is off. -->
<section class="section download" id="download">

  <p class="eyebrow mono">
    <span class="eyebrow__rule"></span>
    <span data-i18n="sec.download">03 — Download</span>
  </p>

  <div class="download__body">

    <h2 class="download__head" id="download-head" data-reveal data-i18n="dl.head">Install once. Reconstruct anywhere.</h2>

    <div class="os-tabs" id="os-tabs" role="tablist" aria-label="Operating system">
      <button class="os-tab mono is-active" type="button" role="tab" data-os="windows" aria-selected="true">Windows</button>
      <button class="os-tab mono"           type="button" role="tab" data-os="macos"   aria-selected="false">macOS</button>
      <button class="os-tab mono"           type="button" role="tab" data-os="linux"   aria-selected="false">Linux</button>
    </div>

    <a class="btn btn--solid-dark btn--large" id="download-button" rel="noopener"
       href="https://github.com/harry7557558/spirulae-splat/releases/latest">
      <span data-dl-label>Download for Windows</span><span class="btn__dot"></span>
    </a>

    <div class="spec">
      <p class="spec__title mono" data-i18n="spec.title">Recommended minimum setup</p>
      <div class="spec__grid" id="spec-grid">
        <div class="spec__row">
          <span class="spec__label mono" data-i18n="spec.os">Operating system</span>
          <span class="spec__value">Windows 11</span>
        </div>
        <div class="spec__row">
          <span class="spec__label mono" data-i18n="spec.gpu">GPU</span>
          <span class="spec__value">NVIDIA or AMD · Vulkan 1.2+ · 8 GB VRAM</span>
        </div>
        <div class="spec__row">
          <span class="spec__label mono" data-i18n="spec.cpu">Processor</span>
          <span class="spec__value">Any x86_64 CPU</span>
        </div>
        <div class="spec__row">
          <span class="spec__label mono" data-i18n="spec.memory">Memory</span>
          <span class="spec__value">16 GB RAM</span>
        </div>
        <div class="spec__row">
          <span class="spec__label mono" data-i18n="spec.storage">Storage</span>
          <span class="spec__value">50 GB free space</span>
        </div>
        <div class="spec__row">
          <span class="spec__label mono" data-i18n="spec.install">Installation</span>
          <span class="spec__value">None</span>
        </div>
      </div>
    </div>

  </div>
</section>


<!-- ══ Support ═══════════════════════════════════════════════════════════════
     Figures come from SITE.funding in assets/js/site.js; the numbers written
     here are the no-JS fallback and should be updated alongside it. -->
<section class="section support" id="support">

  <p class="eyebrow mono">
    <span class="eyebrow__rule"></span>
    <span data-i18n="sec.support">04 — Support us</span>
  </p>

  <div class="support__grid">

    <div class="support__copy">
      <h2 data-reveal data-i18n="sup.head">Fund the machines that build Spirula.</h2>
      <p data-reveal data-i18n="sup.sub">Spirula stays free and open source. Instead of asking for open-ended donations, we crowdfund the specific hardware that makes development faster — and we show you exactly where every contribution goes.</p>
    </div>

    <div class="goal" id="goal">

      <div class="goal__head">
        <div class="goal__figure">
          <img src="assets/img/goal-radeon-pro-w7800.png" alt="AMD Radeon Pro W7800">
        </div>
        <div class="goal__copy">
          <h3>AMD Radeon™ Pro W7800 workstation</h3>
          <p class="goal__price mono">$2,800 USD</p>
          <p data-reveal data-i18n="sup.nextPurpose">A pro-grade AMD GPU so Spirula runs as well on Radeon as it does on NVIDIA — every AMD bug reproduced and fixed on real hardware.</p>
        </div>
      </div>

      <div class="goal__progress">
        <p class="goal__progress-head">
          <span class="mono" data-i18n="sup.raisedLabel">Raised so far</span>
          <span class="mono goal__raised" id="goal-raised">$10 / $2,800 · &lt;1%</span>
        </p>
        <div class="goal__bar">
          <div class="goal__bar-fill" id="goal-bar" style="width: 0.8%"></div>
        </div>
        <p class="goal__togo mono" id="goal-togo">$2,790 to go</p>
      </div>

      <div class="donate">
        <p class="donate__label mono" data-i18n="sup.amount">Choose an amount</p>

        <div class="donate__freq">
          <button class="chip is-active" type="button" data-freq="one-time"  data-i18n="sup.freqOnce" aria-pressed="true">One-time</button>
          <button class="chip"           type="button" data-freq="recurring" data-i18n="sup.freqMonthly" aria-pressed="false">Monthly</button>
        </div>

        <div class="donate__tiers">
          <button class="tier"           type="button" data-tier="0" aria-pressed="false">$5</button>
          <button class="tier is-active" type="button" data-tier="1" aria-pressed="true">$20</button>
          <button class="tier"           type="button" data-tier="2" aria-pressed="false">$50</button>
          <button class="tier"           type="button" data-tier="3" aria-pressed="false">$100</button>
          <input class="tier tier--input" id="donate-custom" type="number" min="1"
                 placeholder="Custom" aria-label="Custom amount">
        </div>

        <a class="btn btn--solid-dark btn--block" id="sponsor-link" target="_blank" rel="noopener"
           href="https://github.com/sponsors/ChaoqinRobotics?frequency=one-time&amount=20">
          <span data-i18n="sup.back">Support this goal</span>
          <span class="mono donate__amount" id="sponsor-amount">$20</span>
        </a>

        <p class="donate__note" data-reveal data-i18n="sup.note">Checkout opens on GitHub Sponsors. Payments are processed in USD; monthly support can be cancelled anytime.</p>
      </div>

    </div>
  </div>
</section>


<!-- ══ Contact ═══════════════════════════════════════════════════════════════ -->
<section class="section contact" id="contact">
  <div class="contact__glow contact__glow--a" aria-hidden="true"></div>
  <div class="contact__glow contact__glow--b" aria-hidden="true"></div>

  <p class="eyebrow mono">
    <span class="eyebrow__rule"></span>
    <span data-i18n="sec.contact">05 — Contact</span>
  </p>

  <div class="contact__body">
    <h2 data-reveal data-i18n="contact.head">Let's build the future.</h2>
    <p data-reveal data-i18n="contact.sub">Questions about a capture, a pipeline integration, or a bug you can reproduce — write to us and a human who works on Spirula answers.</p>
    <div class="contact__action">
      <a class="btn btn--solid-dark" href="mailto:hello@spirula.studio" data-i18n="contact.cta">Contact us<span class="btn__dot"></span></a>
    </div>
  </div>
</section>

</main>


